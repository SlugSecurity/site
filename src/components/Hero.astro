---
import { site, links } from '@/consts'
---

<section class="relative pt-8 pb-6 sm:pb-8">
	<div class="container-tight text-center">
		<h1 class="brand text-5xl sm:text-7xl md:text-8xl leading-none mb-1">
			{site.name}
		</h1>
		<p class="font-pixel card-title text-(--color-fg-dim) max-w-xl mx-auto mb-4">
			{site.tagline}
		</p>
		<div class="flex flex-wrap items-center justify-center gap-3">
			<a href="/join" class="btn btn-primary">Join SlugSec</a>
			<a href={links.discord} class="btn">Discord</a>
		</div>
	</div>
</section>
