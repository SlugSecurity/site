---
import { getAllPosts } from '@/lib/posts'
import PostList from '@/components/PostList.astro'
import { Icon } from 'astro-icon/components'

const recent = (await getAllPosts()).slice(0, 4)
---

<section class="container-tight section-gap">
	<div class="text-center mb-4">
		<h2 class="section-title mb-2">Recent posts</h2>
	</div>

	{recent.length === 0 ? (
		<div class="panel text-base text-(--color-fg-dim) text-center">
			No posts yet
		</div>
	) : (
		<PostList posts={recent} />
	)}

	<div class="text-center mt-6">
		<a href="/posts" class="label-sm text-link link-arrow"><span><span data-scramble>View all posts</span><Icon name="lucide:arrow-right" aria-hidden="true" /></span></a>
	</div>
</section>
