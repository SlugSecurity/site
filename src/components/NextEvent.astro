---
import { calendar } from '@/consts'
import { events, fmtTimeRange, badgeText, truncate } from '@/lib/events'

const upcoming = events
	.filter(e => new Date(e.end) > new Date())
	.sort((a, b) => new Date(a.start).getTime() - new Date(b.start).getTime())
	.slice(0, 3)

function fmtParts(iso: string) {
	const d = new Date(iso)
	return {
		day: d.toLocaleDateString('en-US', { weekday: 'long', timeZone: calendar.timezone }),
		date: d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: calendar.timezone }),
	}
}
---

<section class="container-tight" aria-labelledby="next-event-heading">
	<div class="panel next-event-panel">
		<div class="next-event-header">
			<h2 id="next-event-heading" class="label text-(--color-fg-dim)">Upcoming events</h2>
			<a href="/events" class="link label inline-flex items-center text-(--color-fg-dim) hover:text-(--color-fg) transition-colors">All events</a>
		</div>

		{upcoming.length > 0 ? (
			<ul class="next-event-list" aria-label="Upcoming events">
				{upcoming.map((event, index) => {
					const date = fmtParts(event.start)
					return (
						<li class="next-event-row">
							<div class="event-meta metadata text-(--color-fg-dim)">
								<div class="event-when">
									<div>{date.day}</div>
									<time datetime={event.start} class="event-date card-title font-pixel text-(--color-fg)">{date.date}</time>
								</div>
								<div class="mt-2"><span class="sr-only">Time: </span>{fmtTimeRange(event.start, event.end)}</div>
								{event.location && <div class="mt-1"><span class="sr-only">Location: </span>{event.location}</div>}
								{(event.private || event.competition || event.tags?.length || event.host) && (
									<div class="flex flex-wrap items-center gap-1.5 mt-2">
										{event.private && <span class="ev-badge ev-private">{badgeText(event.private, 'PRIVATE')}</span>}
										{event.competition && <span class="ev-badge ev-comp">{badgeText(event.competition, 'COMPETITION')}</span>}
										{event.tags?.map(tag => <span class="ev-tag">{tag}</span>)}
										{event.host && <span>Host: {event.host}</span>}
									</div>
								)}
							</div>
							<div class="event-content min-w-0">
								<h3 class="card-title">{event.title}</h3>
								{event.description && <p class="text-base text-(--color-fg-dim) mt-2 leading-relaxed">{truncate(event.description)}</p>}
							</div>
							{index === 0 && (
								<div class="next-event-action">
									<a href={calendar.addUrl} class="btn btn-primary">Add to calendar</a>
								</div>
							)}
						</li>
					)
				})}
			</ul>
		) : (
			<div class="text-(--color-fg-dim)">
				No events scheduled yet. <a href={calendar.addUrl} class="text-link">Subscribe to the calendar</a>
			</div>
		)}
	</div>
</section>

<style>
	.next-event-panel { container-type: inline-size; padding: 1rem; }
	.next-event-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}
	.next-event-header a { min-height: 28px; margin-inline-start: auto; }
	.next-event-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: start;
		gap: 0.75rem 1rem;
	}
	.next-event-row + .next-event-row {
		margin-top: 0.75rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--color-line);
	}
	.next-event-row + .next-event-row .card-title { font-size: var(--text-body); }
	.next-event-row + .next-event-row .event-content > p { font-size: var(--text-meta); margin-top: 0.375rem; }
	.next-event-row + .next-event-row .event-meta { line-height: 1.35; }
	.next-event-row + .next-event-row .event-when { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.5rem; }
	.next-event-row + .next-event-row .event-date { margin-top: 0; }
	.next-event-row + .next-event-row .event-meta > .mt-2 { margin-top: 0.375rem; }
	.event-meta { min-width: 0; }
	.event-date { display: block; margin-top: 0.25rem; }
	.next-event-action .btn { width: 100%; }
	@container (min-width: 35rem) {
		.next-event-row { grid-template-columns: 11rem minmax(0, 1fr); }
		.next-event-action { grid-column: 2; }
		.next-event-action .btn { width: auto; }
	}
	@container (min-width: 52rem) {
		.next-event-row:first-child { grid-template-columns: 11rem minmax(0, 1fr) auto; }
		.next-event-action { grid-column: 3; }
	}
</style>
