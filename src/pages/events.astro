---
import Base from '@/layouts/Base.astro'
import { calendar, links } from '@/consts'
---

<Base title="Events" description="Upcoming Slug Security meetings, CTFs, and socials.">
	<section class="container-prose page-intro">
		<h1 class="page-title">Events</h1>
		<div class="text-base text-(--color-fg-dim) leading-relaxed space-y-2 mb-4">
			<p>Some events are only open to certain groups. Please check the event details</p>
			<p>Curious about restricted events? Ask us on <a href={links.discord} class="text-link">Discord</a></p>
		</div>
		<div class="flex flex-wrap justify-center gap-2">
			<a href={calendar.addUrl} class="btn btn-primary">Add to Google Calendar</a>
			<a href={calendar.icsUrl} class="btn">Calendar feed (.ics)</a>
		</div>
	</section>

	<section class="mx-auto sm:px-5 max-w-[92rem]">
		<div class="frame sm:p-1">
			<iframe
				id="events-calendar"
				src={calendar.embedUrl}
				title="Slug Security Google Calendar"
				class="block w-full h-[600px] sm:h-[720px] md:h-[820px] bg-white border-0"
				loading="lazy"
			></iframe>
		</div>
	</section>
</Base>

<script>
	const frame = document.querySelector<HTMLIFrameElement>('#events-calendar')
	if (frame) {
		const desktopUrl = frame.src
		const agendaUrl = new URL(desktopUrl)
		agendaUrl.searchParams.set('mode', 'AGENDA')
		const desktop = window.matchMedia('(min-width: 40rem)')
		const updateView = () => {
			const source = desktop.matches ? desktopUrl : agendaUrl.href
			if (frame.src !== source) frame.src = source
		}
		desktop.addEventListener('change', updateView)
		updateView()
	}
</script>
