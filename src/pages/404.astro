---
import { readdirSync } from 'node:fs'
import Base from '@/layouts/Base.astro'

const cats = readdirSync('public/_assets/animated/404').filter((f) => f.endsWith('.gif'))

const facts = [
	'cats are often found around campfires',
	'a group of cats is called a clowder',
	'cats use their whiskers to measure distances',
	"the world's richest cat inherited $13 million from its owner",
	`did you know we have ${cats.length} variations of this gif?`,
	'the CIA tried to train cats as spies in the 1960s',
	'stubbs the cat was the mayor of talkeetna, alaska for 20 years',
	'cats only meow to communicate with humans, not other cats',
	'the oldest cat on record lived to 38 years old',
	'house cats share 95% of their dna with tigers',
	'ancient egyptians shaved their eyebrows to mourn a dead cat',
	'two cats at the dutch embassy in moscow once exposed soviet listening devices',
	"cats can't taste sweetness",
	'cats have 32 muscles in each ear',
]
---

<Base title="404" description="Page not found." noindex>
	<section class="container-prose pt-8 text-center">
		<h1 class="text-7xl sm:text-9xl mb-2">404</h1>
		<p class="text-(--color-fg-dim) mb-6">nothing here but us cats</p>
		<div class="flex justify-center">
			<img id="cat-404" alt="A playful animated collage of cats." data-cats={cats.join(',')} data-facts={facts.join('|')} class="max-w-full max-h-[45vh]" />
		</div>
		<p id="cat-fact" class="text-base text-(--color-fg-dim) mt-4" hidden></p>
		<p class="mt-6 text-base text-(--color-fg-dim)">
			Try the <a href="/" class="text-link">home page</a> or browse our <a href="/posts" class="text-link">posts</a>
		</p>
	</section>
</Base>

<script>
	const img = document.querySelector<HTMLImageElement>('#cat-404')
	const fact = document.getElementById('cat-fact')
	if (img && fact) {
		const cats = (img.dataset.cats ?? '').split(',').filter(Boolean)
		const facts = (img.dataset.facts ?? '').split('|').filter(Boolean)
		const cat = cats[Math.floor(Math.random() * cats.length)]
		if (cat) img.src = `/_assets/animated/404/${cat}`
		fact.textContent = facts[Math.floor(Math.random() * facts.length)] ?? ''
		fact.hidden = !fact.textContent
	}
</script>
