---
import Base from '@/layouts/Base.astro'
import { Icon } from 'astro-icon/components'
import { readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import yaml from 'js-yaml'

type Officer = {
	Name: string
	Title: string
	Handle?: string
	Description: string
	Image: string
	Website?: string
	LinkedIn?: string
	GitHub?: string
	Twitter?: string
}

type Quarter = { quarter: string; names: string[] }

const officersRaw = readFileSync(resolve(process.cwd(), 'src/data/officers.yml'), 'utf8')
const officersData = yaml.load(officersRaw) as { executive: Officer[]; officers: Officer[]; alumni: Officer[] }
const executive = officersData.executive ?? []
const officers = officersData.officers ?? []
const alumni = officersData.alumni ?? []

const membersRaw = readFileSync(resolve(process.cwd(), 'src/data/members.yml'), 'utf8')
const quarters = (yaml.load(membersRaw) as { members: Quarter[] }).members

const fixImage = (p: string) => p.replace('/_assets/images/officers/', '/_assets/officers/')

type Group = { name: string; list: Officer[]; muted?: boolean }
const groupOrder: Group[] = [
	{ name: 'Executive', list: executive },
	{ name: 'Officers', list: officers },
	{ name: 'Alumni', list: alumni, muted: true },
]
---

<Base title="Members" description="Meet our members, officers, and alumni">
	<section class="container-prose page-intro">
		<h1 class="page-title">Members</h1>
		<p class="text-(--color-fg-dim)">Meet our members, officers, and alumni</p>
	</section>

	<section class="container-tight">
		<div id="leadership" class="mb-4 scroll-mt-20">
			<h2 class="section-heading section-title"><span>Leadership</span></h2>
		</div>

		{groupOrder.map(group => {
			if (group.list.length === 0) return null
			return (
				<div class="officer-group">
					<div class="mb-3">
						<h3 class:list={['section-heading card-title', group.muted ? 'text-(--color-fg-dim)' : 'text-(--color-fg)']}><span>{group.name} ({group.list.length})</span></h3>
					</div>
					<ul class="grid lg:grid-cols-2 gap-4">
						{group.list.map(o => (
							<li class="officer-card panel">
								<div class="officer-header">
									<img
										src={fixImage(o.Image)}
										alt=""
										loading="lazy"
										width="88"
										height="88"
										class="officer-avatar"
									/>
									<div class="officer-info">
										<div class="officer-identity leading-tight">
											<div class="label-sm text-(--color-accent)">{o.Title}</div>
											<h4 class="card-title text-(--color-fg)">{o.Name}</h4>
										</div>
										<div class="officer-meta text-(--color-fg-dim)">
											{o.Handle && (
												<span class="officer-handle label-sm text-(--color-fg-faint)">@{o.Handle}</span>
											)}
											{o.Website && (
												<a href={o.Website} title="Website" aria-label={`${o.Name} website`} class="officer-icon">
													<Icon name="lucide:globe" width="18" height="18" aria-hidden="true" />
												</a>
											)}
											{o.LinkedIn && (
												<a href={`https://www.linkedin.com/in/${o.LinkedIn}`} title="LinkedIn" aria-label={`${o.Name} LinkedIn`} class="officer-icon">
													<Icon name="simple-icons:linkedin" width="18" height="18" aria-hidden="true" />
												</a>
											)}
											{o.GitHub && (
												<a href={`https://github.com/${o.GitHub}`} title="GitHub" aria-label={`${o.Name} GitHub`} class="officer-icon">
													<Icon name="simple-icons:github" width="18" height="18" aria-hidden="true" />
												</a>
											)}
											{o.Twitter && (
												<a href={`https://twitter.com/${o.Twitter}`} title="Twitter" aria-label={`${o.Name} Twitter`} class="officer-icon">
													<Icon name="simple-icons:x" width="18" height="18" aria-hidden="true" />
												</a>
											)}
										</div>
									</div>
								</div>
								<p class="text-base text-(--color-fg-dim) leading-relaxed mt-2">{o.Description}</p>
							</li>
						))}
					</ul>
				</div>
			)
		})}

		<div id="active-members" class="section-gap mb-4 scroll-mt-20">
			<h2 class="section-heading section-title"><span>Active members</span></h2>
		</div>
		<p class="text-base text-(--color-fg-dim) mb-6">
			See who was active each quarter. <a href="/join" class="text-link">Join SlugSec</a>
		</p>

		<button id="anon-toggle" type="button" class="btn btn-sm mb-3" aria-controls="member-rosters" hidden>Pause name animation</button>
		<div id="member-rosters">
		{quarters.map((q, i) => (
			<div class="mt-3">
				<div class="panel">
					<div class="mb-3">
						<h3 class="section-heading card-title"><span>{q.quarter} ({q.names.length || '-'})</span></h3>
					</div>
					{q.names.length === 0 ? (
						<p class="label-sm text-(--color-fg-faint)">Member list not added yet</p>
					) : (
						<ul class="member-grid label-sm text-(--color-fg-dim)">
							{q.names.map(n => {
								if (n.trim() !== '?') return <li>{n}</li>
								const tip = 'This member prefers to stay anonymous'
								return <li><span class="anon-mask" title={tip}><span class="anon-scramble" aria-hidden="true">????????</span><span class="sr-only">{tip}</span></span></li>
							})}
						</ul>
					)}
				</div>
				{i === quarters.length - 1 && (
					<p class="label-sm text-(--color-fg-faint) text-center mt-3">Member lists go back to Fall 2025</p>
				)}
			</div>
		))}
		</div>
	</section>
</Base>

<script>
	import GlitchedWriter from 'glitched-writer'
	import '@/scripts/member-cards'

	const toggle = document.querySelector<HTMLButtonElement>('#anon-toggle')
	const names = Array.from(document.querySelectorAll<HTMLElement>('.anon-scramble'))
	if (toggle && names.length) {
		const glyphs = '!<>-_\\/[]{}=+*^?#%&~01ABCDEF'
		const motion = window.matchMedia('(min-width: 768px) and (prefers-reduced-motion: no-preference)')
		const writers = names.map(element => ({
			writer: new GlitchedWriter(element, { steps: [4, 8], interval: [70, 140], glyphs }),
			length: 6 + Math.floor(Math.random() * 6),
			timer: 0,
		}))
		let paused = false
		let generation = 0
		const update = () => {
			const run = ++generation
			toggle.hidden = !motion.matches
			toggle.textContent = paused ? 'Resume name animation' : 'Pause name animation'
			for (const item of writers) {
				clearTimeout(item.timer)
				item.writer.pause()
				if (paused || !motion.matches) continue
				const tick = () => {
					if (run !== generation) return
					const seed = Array.from({ length: item.length }, () => glyphs[Math.floor(Math.random() * glyphs.length)]).join('')
					void item.writer.write(seed).then(() => {
						if (run === generation) item.timer = window.setTimeout(tick, 1800 + Math.random() * 800)
					})
				}
				tick()
			}
		}
		toggle.addEventListener('click', () => { paused = !paused; update() })
		motion.addEventListener('change', update)
		update()
	}
</script>

<style>
	#anon-toggle[hidden] { display: none; }
	.officer-group + .officer-group { margin-top: 1.5rem; }
	.officer-header {
		--officer-avatar-size: 80px;
		display: grid;
		grid-template-columns: var(--officer-avatar-size) minmax(0, 1fr);
		align-items: start;
		gap: 0.25rem 0.75rem;
	}
	.officer-info {
		min-width: 0;
	}
	.officer-card {
		container-type: inline-size;
		display: flex;
		flex-direction: column;
		padding: 0.75rem;
		transition: border-color 160ms;
	}
	.officer-card:hover {
		border-color: var(--color-line-bright);
	}
	.officer-avatar {
		width: var(--officer-avatar-size);
		height: var(--officer-avatar-size);
		object-fit: cover;
	}
	.officer-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.125rem;
		font-family: var(--font-pixel);
		font-size: var(--text-meta);
		line-height: 1.5;
	}
	.officer-handle {
		max-width: 100%;
		margin-inline-end: 0.375rem;
	}
	.officer-icon {
		flex: 0 0 44px;
		width: 44px;
		height: 44px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: color 160ms;
	}
	.officer-icon:hover {
		color: var(--color-accent);
	}
	.officer-icon :global(svg) {
		display: block;
		transform: translateY(-0.0625rem);
	}
	@supports (width: 1cap) {
		.officer-meta { align-items: baseline; }
		.officer-icon { align-items: flex-start; }
		.officer-icon :global(svg) { transform: translateY(calc(9px - 0.5cap)); }
	}
	@container (min-width: 25rem) {
		.officer-header {
			--officer-avatar-size: 88px;
		}
	}
	@container (max-width: 13rem) {
		.officer-header { grid-template-columns: minmax(0, 1fr); }
	}
	@media (min-width: 48rem) and (pointer: fine) {
		.officer-icon {
			flex-basis: 32px;
			width: 32px;
			height: 32px;
		}
	}
	.member-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
		gap: 0.65rem 1.5rem;
	}
	.anon-mask {
		display: inline-block;
		color: var(--color-fg-faint);
		min-width: 5rem;
	}
	.anon-mask:hover {
		color: var(--color-fg-dim);
	}
</style>
