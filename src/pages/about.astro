---
import Base from '@/layouts/Base.astro'
import AboutSection from '@/components/AboutSection.astro'
import { Icon } from 'astro-icon/components'
import { site, sponsors } from '@/consts'

const competitions = [
	{
		head: 'Capture the Flag',
		icon: 'lucide:flag',
		body: `<p>In most Capture the Flag (CTF) competitions, you work with teammates to solve security puzzles. Find a hidden flag and submit it for points. Challenges cover web security, reverse engineering, cryptography, forensics, and more</p><p class="mt-2">New to CTFs? <a href="https://www.youtube.com/watch?v=8ev9ZX9J45A" class="text-link">Watch a quick explainer</a> or read <a href="https://ctfd.io/whats-a-ctf/" class="text-link">CTFd's CTF guide</a></p><p class="mt-2">After a competition, share how you solved a challenge and what you learned. We'd love to see your writeup on our <a href="/posts" class="text-link">posts page</a></p>`,
	},
	{
		head: 'Cyber Defense',
		icon: 'lucide:shield',
		body: `<p>Your team keeps a network running while another team tries to break in. You'll fix security problems, help users, and respond to incidents</p><p class="mt-2">We take part in the Collegiate Cyber Defense Competition (CCDC) in the Western region. Teams look after a simulated company's network while handling business tasks and defending against attacks</p>`,
	},
	{
		head: 'Attack / Defend',
		icon: 'lucide:swords',
		body: `<p>Build a secure system, then test other teams' designs while they test yours</p><p class="mt-2">In MITRE's Embedded Capture the Flag (eCTF), teams build software for a small hardware device using the competition's requirements. Later, they look for security flaws in each other's systems</p>`,
	},
]

const rules = [
	{
		icon: 'lucide:heart',
		strong: 'Treat everyone with respect',
		body: 'No personal attacks, harassment, or discrimination. Disagree with an idea without making it personal',
	},
	{
		icon: 'lucide:smile',
		strong: "Don't talk down to people",
		body: 'Help people understand instead of showing them up. A question about Linux doesn\'t need an "actually, it\'s GNU/Linux" lecture',
	},
	{
		icon: 'lucide:hand-helping',
		strong: 'Give back to the community',
		body: 'Share what you know. If someone is struggling at a meeting, take a moment to teach them',
	},
	{
		icon: 'lucide:ban',
		strong: "Don't be evil",
		body: "Get permission before hacking a system. Don't harm people or break the law. If you're unsure, ask first",
	},
]
---

<Base title="About" description={`About ${site.name}, the cybersecurity organization at UC Santa Cruz.`}>
	<section class="container-prose page-intro">
		<h1 class="page-title">About</h1>
	</section>

	<article class="container-prose space-y-5 text-(--color-fg-dim) leading-relaxed">
		<p>
			Student-run org under Baskin Engineering focused on all things computer security. All programming comes from students with faculty oversight for leadership. Founded in 2022 after students wanted a community around security. There was a club before us (Security Santa Cruz) but it faded around 2014
		</p>
		<p class="text-(--color-accent) font-pixel">
			TLDR: we do cool stuff with computers
		</p>
		<p>
			This group is open to all students consistent with state and federal law, the UC Nondiscrimination Statement and the Nondiscrimination Policy Statement for University of California Publications Regarding Student-Related Matters.
		</p>
	</article>

	<AboutSection id="what-we-do" />

	<section id="cyber-research" class="container-prose section-gap scroll-mt-20">
		<div class="text-center mb-4">
			<h2 class="section-title">Cyber research at UCSC</h2>
		</div>
		<p class="text-(--color-fg-dim) leading-relaxed">
			In 2025, the National Security Agency (NSA) named UC Santa Cruz a National Center of Academic Excellence in Cyber Research (<a href="https://news.ucsc.edu/2025/10/uc-santa-cruz-national-center-of-academic-excellence-in-cyber-research/" class="text-link">CAE-R</a>). The designation recognizes UCSC's cybersecurity research
		</p>
		<p class="text-(--color-fg-dim) leading-relaxed mt-3">
			Students can learn and collaborate with other CAE-R schools through workshops and research events. UCSC students and alumni can also meet employers at the CAE community's annual <a href="https://www.caecommunity.org/national-cyber-and-ai-career-fair" class="text-link">virtual career fair</a>
		</p>
	</section>

	<section id="competitions" class="container-prose section-gap scroll-mt-20">
		<div class="text-center mb-4">
			<h2 class="section-title">Competitions</h2>
		</div>
		<div class="space-y-6 text-(--color-fg-dim) leading-relaxed">
			{competitions.map(c => (
				<div>
					<h3 class="card-title text-(--color-fg) mb-2 icon-row gap-2">
						<Icon name={c.icon} class="text-(--color-accent)" aria-hidden="true" />
						<span>{c.head}</span>
					</h3>
					<div set:html={c.body}></div>
				</div>
			))}
		</div>
	</section>

	<section id="not-cs" class="container-prose section-gap scroll-mt-20">
		<div class="text-center mb-4">
			<h2 class="section-title">I'm not a CS major</h2>
		</div>
		<p class="text-(--color-fg-dim) leading-relaxed">
			You're welcome here. Security needs people with all kinds of interests, from art and design to law and hardware
		</p>
		<p class="text-(--color-fg-dim) leading-relaxed mt-3">
			Economics, politics, and art majors have joined our CTF teams and club projects
		</p>
	</section>

	<section id="rules" class="container-prose section-gap scroll-mt-20">
		<div class="text-center mb-4">
			<h2 class="section-title">Member rules</h2>
		</div>
		<ul class="space-y-3 text-(--color-fg-dim) leading-relaxed">
			{rules.map(r => (
				<li class="icon-row gap-3">
					<Icon name={r.icon} class="text-(--color-accent)" aria-hidden="true" />
					<div>
						<strong class="block text-(--color-fg)">{r.strong}</strong>
						<p>{r.body}</p>
					</div>
				</li>
			))}
		</ul>
	</section>

	<section id="sponsors" class="container-prose section-gap scroll-mt-20">
		<div class="text-center mb-4">
			<h2 class="section-title">Sponsors</h2>
		</div>
		<div class="text-(--color-fg-dim) leading-relaxed space-y-4">
			<p>
			We run security workshops, compete in CCDC and MITRE eCTF, and give students a place to learn by doing
			</p>
			<p>
				Sponsors help pay for competition travel, equipment, our servers, and events. We also receive support from alumni and university grants
			</p>
			<p>
				Want to support the club? Email us at <a href={`mailto:${site.email}`} class="text-link">{site.email}</a>
			</p>
			<p>
				{site.name} operates under The Regents of the University of California, a 501(c)(3) nonprofit organization (EIN 94-1539563). Donations are tax-deductible to the extent allowed by law.
			</p>
		</div>

		<div class="text-center label-sm text-(--color-fg-dim) mt-10 mb-4">Our sponsors</div>
		<ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-8">
			{sponsors.map(s => {
				const w = s.aspect === 'square' ? '7rem' : '18rem'
				return (
					<li class="flex items-center justify-center max-w-full">
						<a
							href={s.href}
							title={s.name}
							aria-label={s.name}
							style={`display: block; width: ${w}; max-width: 100%; height: 7rem; background-image: url(${s.logo}); background-position: center; background-repeat: no-repeat; background-size: contain;`}
						></a>
					</li>
				)
			})}
		</ul>
	</section>
</Base>
