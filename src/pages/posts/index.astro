---
import Base from '@/layouts/Base.astro'
import { getAllPosts } from '@/lib/posts'
import PostList from '@/components/PostList.astro'

const all = await getAllPosts()

const grouped = all.reduce((acc, p) => {
	const year = p.data.date.getUTCFullYear()
	if (!acc[year]) acc[year] = []
	acc[year].push(p)
	return acc
}, {} as Record<number, typeof all>)

const years = Object.keys(grouped).map(Number).sort((a, b) => b - a)
---

<Base title="Posts" description="Technical writeups, club updates, and thoughts from our members">
	<section class="container-prose page-intro">
		<h1 class="page-title">Posts</h1>
		<p class="text-(--color-fg-dim)">Technical writeups, club updates, and thoughts from our members</p>
	</section>

	<section class="container-tight">
		{years.map(year => (
			<div class="mb-6 last:mb-0">
				<div class="mb-3">
					<h2 class="section-heading card-title text-(--color-fg) tabular-nums"><span>{year} ({grouped[year].length})</span></h2>
				</div>
				<PostList posts={grouped[year]} />
			</div>
		))}
	</section>
</Base>
