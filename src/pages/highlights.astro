---
import Base from '@/layouts/Base.astro'
import { readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import yaml from 'js-yaml'

type Highlight = {
	Name: string
	Date: Date | string
	Type: string
	Location: string
	Placement: number | string
	Participants: number | string
	Article?: string | null
	Writeup?: string | null
}

const raw = readFileSync(resolve(process.cwd(), 'src/data/highlights.yml'), 'utf8')
const parsed = yaml.load(raw) as { highlights: Record<string, Highlight[]> }
const years = Object.keys(parsed.highlights).sort((a, b) => Number(b) - Number(a))
const all = years.flatMap(y => parsed.highlights[y])
const currentYear = new Date().getFullYear()

const totalEvents = all.length
const podium = all.filter(h => Number(h.Placement) <= 3).length
const topTen = all.filter(h => Number(h.Placement) / Number(h.Participants) <= 0.1).length
const thisYear = parsed.highlights[String(currentYear)]?.length ?? 0

const typeCounts = new Map<string, number>()
for (const h of all) typeCounts.set(h.Type, (typeCounts.get(h.Type) ?? 0) + 1)
const types = Array.from(typeCounts.entries()).sort((a, b) => b[1] - a[1])

function tierOf(placement: number | string, participants: number | string) {
	const p = Number(placement)
	const ratio = p / Number(participants)
	if (p === 1) return 'gold'
	if (p === 2) return 'silver'
	if (p === 3) return 'bronze'
	if (ratio <= 0.1) return 'top'
	return 'normal'
}

function topPct(placement: number | string, participants: number | string) {
	const r = Number(placement) / Number(participants)
	return Math.max(1, Math.ceil(r * 100))
}

function fmtDate(d: Date | string) {
	const date = typeof d === 'string' ? new Date(d) : d
	return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
}

function fmtCount(n: number | string) {
	const v = Number(n)
	if (v < 1000) return String(v)
	if (v < 10000) return (v / 1000).toFixed(1).replace(/\.0$/, '') + 'k'
	return Math.round(v / 1000) + 'k'
}

function ordinal(n: number) {
	const s = ['th', 'st', 'nd', 'rd']
	const v = n % 100
	return n + (s[(v - 20) % 10] || s[v] || s[0])
}

function typeSlug(t: string) {
	return t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
}

---

<Base title="Highlights" description="Events, competitions, and team results">
	<section class="container-prose page-intro">
		<h1 class="page-title">Highlights</h1>
		<p class="text-(--color-fg-dim)">Events, competitions, and team results</p>
	</section>

	<section class="container-tight">
		<div class="stats">
			<div class="stat">
				<div class="stat-label">competitions</div>
				<div class="stat-num">{totalEvents}</div>
			</div>
			<div class="stat">
				<div class="stat-label">top 3 finishes</div>
				<div class="stat-num text-(--color-accent)">{podium}</div>
			</div>
			<div class="stat">
				<div class="stat-label">top 10% results</div>
				<div class="stat-num">{topTen}</div>
			</div>
			<div class="stat">
				<div class="stat-label">{currentYear} so far</div>
				<div class="stat-num">{thisYear}</div>
			</div>
		</div>
	</section>

	<section class="container-tight pt-4">
		<div class="filter-bar" role="group" aria-label="Filter by type">
			<button type="button" class="filter-pill active" data-filter="all" aria-pressed="true" aria-controls="highlights-list">
				<span>All</span><span class="filter-count">{totalEvents}</span>
			</button>
			{types.map(([t, count]) => (
				<button type="button" class="filter-pill" data-filter={typeSlug(t)} aria-pressed="false" aria-controls="highlights-list">
					<span>{t}</span><span class="filter-count">{count}</span>
				</button>
			))}
		</div>
		<p id="filter-status" class="sr-only" role="status" aria-atomic="true"></p>
	</section>

	<section class="container-tight pt-3">
		<nav class="year-jump label" aria-label="Competition years">
			<span class="text-(--color-fg-dim)">Jump to year</span>
			{years.map(y => (
				<a href={`#y-${y}`} class="year-link" data-year={y}>{y}</a>
			))}
		</nav>
	</section>

	<section class="container-tight pt-4" id="highlights-list">
		{years.map(year => (
			<div class="year-block" id={`y-${year}`} data-year={year}>
				<div class="year-header">
					<h2 class="section-heading year-tag"><span>{year} <span class="year-count">({parsed.highlights[year].length})</span></span></h2>
				</div>

				<ul class="entries">
					{parsed.highlights[year].map(h => {
						const tier = tierOf(h.Placement, h.Participants)
						const pct = topPct(h.Placement, h.Participants)
						const place = Number(h.Placement)
						const hasLinks = Boolean(h.Article || h.Writeup)
						return (
							<li class:list={[`entry tier-${tier}`, hasLinks && 'has-links']} data-type={typeSlug(h.Type)}>
								<div class="entry-rank">
									<span class="rank-place">{ordinal(place)}</span>
									<span class="rank-detail">out of {fmtCount(h.Participants)}</span>
								</div>
								<h3 class="entry-name">{h.Name}</h3>
								<div class="entry-meta">
									<span class="m-type">{h.Type}</span>
									<span class="m-sep" aria-hidden="true">-</span>
									<span class="m-loc">{h.Location}</span>
									<span class="m-sep" aria-hidden="true">-</span>
									<span class="m-date">{fmtDate(h.Date)}</span>
									<span class="m-sep" aria-hidden="true">-</span>
									<span class={`m-pct pct-${tier}`}>top {pct}%</span>
								</div>
								{hasLinks && (
									<div class="entry-links">
										{h.Article && <a href={h.Article} class="entry-link" aria-label={`Post about ${h.Name}`} rel="noopener">Post</a>}
										{h.Writeup && <a href={h.Writeup} class="entry-link" aria-label={`Writeup for ${h.Name}`} rel="noopener">Writeup</a>}
									</div>
								)}
							</li>
						)
					})}
				</ul>
			</div>
		))}
		<div class="empty-state" hidden>
			<span class="label-sm text-(--color-fg-faint)">No competitions match this filter</span>
		</div>
	</section>
</Base>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-pill')
	const entries = document.querySelectorAll<HTMLElement>('.entry')
	const yearBlocks = document.querySelectorAll<HTMLElement>('.year-block')
	const yearLinks = document.querySelectorAll<HTMLAnchorElement>('.year-link')
	const empty = document.querySelector<HTMLElement>('.empty-state')
	const status = document.getElementById('filter-status')

	buttons.forEach(btn => {
		btn.addEventListener('click', () => {
			const f = btn.dataset.filter ?? 'all'
			buttons.forEach(b => {
				b.classList.toggle('active', b === btn)
				b.setAttribute('aria-pressed', String(b === btn))
			})

			let visibleTotal = 0
			entries.forEach(e => {
				const show = f === 'all' || e.dataset.type === f
				e.classList.toggle('is-hidden', !show)
				if (show) visibleTotal++
			})
			yearBlocks.forEach(yb => {
				const visible = yb.querySelectorAll('.entry:not(.is-hidden)').length
				yb.classList.toggle('is-hidden', visible === 0)
				const count = yb.querySelector('.year-count')
				if (count) count.textContent = `(${visible})`
				yearLinks.forEach(link => {
					if (link.dataset.year === yb.dataset.year) link.classList.toggle('is-hidden', visible === 0)
				})
			})
			if (empty) empty.hidden = visibleTotal > 0
			if (status) status.textContent = `${visibleTotal} ${visibleTotal === 1 ? 'result' : 'results'}`
		})
	})
</script>

<style>
	#highlights-list { container-type: inline-size; }
	.stats {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		background: var(--color-line);
		border: 1px solid var(--color-line);
	}
	.stat {
		background: var(--color-bg-panel);
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-width: 0;
	}
	.stat-label,
	.filter-pill,
	.year-link,
	.year-tag,
	.year-count,
	.entry-links {
		font-family: var(--font-pixel);
		font-size: var(--text-meta);
		line-height: 1.5;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.stat-label,
	.filter-count,
	.year-count,
	.rank-detail,
	.entry-meta {
		color: var(--color-fg-dim);
	}
	.stat-num {
		font-size: var(--text-section);
		line-height: 1.25;
		font-variant-numeric: tabular-nums;
	}
	.filter-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.filter-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		max-width: 100%;
		padding: 0.5rem 0.75rem;
		background: var(--color-bg-panel);
		color: var(--color-fg-dim);
		border: 1px solid var(--color-line-bright);
		cursor: pointer;
	}
	.filter-pill:hover {
		color: var(--color-fg);
	}
	.filter-pill.active {
		color: var(--color-accent);
		border-color: var(--color-accent);
		box-shadow: inset 0 -2px 0 var(--color-accent);
	}
	.filter-count {
		padding-left: 0.5rem;
		border-left: 1px solid var(--color-line);
	}
	.filter-pill.active .filter-count {
		color: inherit;
	}
	.year-jump {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}
	.year-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		padding-inline: 0.5rem;
		color: var(--color-fg-dim);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.year-link:hover {
		color: var(--color-accent);
	}
	.year-block + .year-block {
		margin-top: 2rem;
	}
	.year-header {
		margin-bottom: 0.75rem;
	}
	.year-tag {
		color: var(--color-fg);
	}
	.entries {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.entry {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.5rem;
		padding: 0.75rem 1rem;
		background: var(--color-bg-panel);
		border: 1px solid var(--color-line);
		border-left-width: 3px;
	}
	.entry:not(.tier-normal) {
		border-left-color: var(--color-accent);
	}
	.entry-rank {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--color-line);
		font-variant-numeric: tabular-nums;
	}
	.rank-place {
		font-size: var(--text-card);
		line-height: 1.35;
	}
	.rank-detail,
	.entry-meta {
		font-size: var(--text-meta);
		line-height: 1.5;
	}
	.entry:not(.tier-normal) .rank-place {
		color: var(--color-accent);
	}
	.entry-name {
		font-size: var(--text-card);
		line-height: 1.35;
		min-width: 0;
	}
	.entry-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.5rem;
		min-width: 0;
	}
	.entry-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.entry-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.entry-link:hover {
		color: var(--color-fg);
	}
	.empty-state {
		padding: 1.5rem 0;
		text-align: center;
	}
	.is-hidden {
		display: none;
	}
	@media (min-width: 40rem) {
		.stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
	}
	@container (min-width: 40rem) {
		.entry {
			grid-template-columns: 7rem minmax(0, 1fr);
			column-gap: 1rem;
			row-gap: 0.25rem;
		}
		.entry.has-links { grid-template-columns: 7rem minmax(0, 1fr) auto; }
		.entry-rank {
			grid-column: 1;
			grid-row: 1 / span 2;
			flex-direction: column;
			justify-content: center;
			padding: 0 1rem 0 0;
			border-bottom: 0;
			border-right: 1px solid var(--color-line);
		}
		.entry-name,
		.entry-meta {
			grid-column: 2;
		}
		.entry-links { grid-column: 3; grid-row: 1 / span 2; align-self: center; }
	}
</style>
